{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verbo no Chão audio record",
  "type": "object",
  "additionalProperties": false,
  "required": ["voice", "music"],
  "properties": {
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "language", "commercial_use", "evidence_ref", "intelligibility_status"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "language": {"const": "pt-BR"},
        "commercial_use": {"type": "boolean"},
        "evidence_ref": {"type": "string", "minLength": 1},
        "intelligibility_status": {"const": "PASSED"}
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "commercial_use", "evidence_ref", "voice_priority", "lyrics"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "commercial_use": {"type": "boolean"},
        "evidence_ref": {"type": "string", "minLength": 1},
        "voice_priority": {"const": true},
        "lyrics": {"enum": ["none", "instrumental", "cleared"]}
      }
    }
  }
}
