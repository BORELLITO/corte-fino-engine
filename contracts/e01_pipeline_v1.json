{
  "schema_version": "1.0.0",
  "pipeline_id": "vnc-episode-pipeline",
  "episode_id": "E01",
  "description": "Ordem canônica das etapas. Cada etapa só é DONE quando o contrato de evidência declarado satisfaz TODAS as condições. Falha de leitura, campo ausente ou valor diferente nunca conta como DONE.",
  "stages": [
    {"id": "script", "requires": [], "executor": "auto",
     "workflow": "verbo-no-chao-agents.yml",
     "evidence": "contracts/e01_ai_editorial_review_v2.json",
     "done_when": [{"field": "decision_status", "equals": "AUTO_APPROVED_FOR_INTERNAL_PRODUCTION"}]},
    {"id": "voice", "requires": ["script"], "executor": "auto",
     "workflow": "verbo-no-chao-e01-v2-voice.yml",
     "evidence": "contracts/e01_v2_voice_preview_evidence_v1.json",
     "done_when": [{"field": "production_audio_master_approved", "equals": true}]},
    {"id": "asr_audit", "requires": ["voice"], "executor": "auto",
     "workflow": "verbo-no-chao-e01-v2-dual-asr.yml",
     "evidence": "contracts/e01_v2_dual_asr_real_evidence_v1.json",
     "done_when": [{"field": "audio_master_approved", "equals": true}]},
    {"id": "captions", "requires": ["asr_audit"], "executor": "auto",
     "workflow": "verbo-no-chao-e01-v2-captions.yml",
     "evidence": "contracts/e01_v2_caption_qa_real_evidence_v1.json",
     "done_when": [{"field": "script_and_language_qa_status", "equals": "PASS"}]},
    {"id": "s01_hero_clip", "requires": ["script"], "executor": "auto",
     "workflow": "verbo-no-chao-e01-s01-v2-probe.yml",
     "evidence": "contracts/e01_room_a_reference_handoff_v1.json",
     "done_when": [{"field": "approved_source_video_sha256", "is_sha256": true}]},
    {"id": "support_scenes", "requires": ["s01_hero_clip"], "executor": "auto",
     "workflow": "verbo-no-chao-supporting-scenes-qa.yml",
     "evidence": "contracts/e01_v2_stock_candidates_v1.json",
     "done_when": [{"field": "footage_approved_for_edit", "equals": true}]},
    {"id": "roughcut", "requires": ["support_scenes", "captions"], "executor": "auto",
     "workflow": "verbo-no-chao-e01-integration-safe-smoke.yml",
     "evidence": "contracts/e01_v2_visual_full_decode_evidence_v1.json",
     "done_when": [{"field": "full_hd_master_approved", "equals": true}]},
    {"id": "rights", "requires": ["roughcut"], "executor": "auto",
     "workflow": "verbo-no-chao-agents.yml",
     "evidence": "contracts/e01_rights_review_dossier_v1.json",
     "done_when": [{"field": "approved_for_audio", "equals": true}]},
    {"id": "master", "requires": ["rights"], "executor": "auto",
     "workflow": "verbo-no-chao-runflow.yml",
     "evidence": "contracts/e01_v2_caption_qa_real_evidence_v1.json",
     "done_when": [{"field": "final_video_master_approved", "equals": true}]},
    {"id": "publication", "requires": ["master"], "executor": "human_only",
     "workflow": null,
     "evidence": "contracts/e01_rights_review_dossier_v1.json",
     "done_when": [{"field": "publication_authorized", "equals": true}]}
  ]
}
