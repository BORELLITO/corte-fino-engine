{
  "name": "verbo-no-chao-editorial-package",
  "version": "0.1.0",
  "required": [
    "video_id",
    "audience",
    "theme",
    "opening",
    "biblical_basis",
    "reflection",
    "application",
    "conclusion",
    "language",
    "format",
    "duration_seconds",
    "originality",
    "safety"
  ],
  "properties": {
    "video_id": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "theme": {"type": "string", "minLength": 1},
    "opening": {"type": "string", "minLength": 1},
    "biblical_basis": {"type": "object"},
    "reflection": {"type": "string", "minLength": 1},
    "application": {"type": "string", "minLength": 1},
    "conclusion": {"type": "string", "minLength": 1},
    "language": {"enum": ["pt-BR"]},
    "format": {"enum": ["short", "long"]},
    "duration_seconds": {"type": "integer", "minimum": 15, "maximum": 900},
    "originality": {"enum": ["ORIGINAL", "REVIEW_REQUIRED", "BLOCKED"]},
    "safety": {"type": "object"}
  }
}
